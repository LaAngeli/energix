APP_NAME=Energix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Firma si publicul ei sunt in Moldova. Pe UTC, anul din footer ar ramane
# in urma doua ore dupa Revelion.
APP_TIMEZONE=Europe/Chisinau

APP_LOCALE=ro
APP_FALLBACK_LOCALE=ro
APP_FAKER_LOCALE=ro_RO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Site de prezentare: nu folosim baza de date.
# Declarat doar ca fallback inert pentru configul Laravel.
DB_CONNECTION=sqlite

# Driverele sunt pe file/sync pentru ca hostul (Hostinger shared) nu are
# supervisor si nu rulam worker. Vezi .claude/context/DEPLOY-HOSTINGER.md
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

# Local: MAIL_MAILER=log -> mailurile ajung in storage/logs/laravel.log.
# Productie:
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtps
#   MAIL_HOST=smtp.hostinger.com
#   MAIL_PORT=465
#   MAIL_USERNAME=contact@energix.md
#   MAIL_PASSWORD=<secret; doar in .env de pe server, NICIODATA in Git>
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@energix.md"
MAIL_FROM_NAME="${APP_NAME}"

# Destinatarul formularului de contact.
MAIL_TO_ADDRESS="contact@energix.md"

VITE_APP_NAME="${APP_NAME}"
